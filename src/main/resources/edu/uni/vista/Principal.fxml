<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="edu.uni.controlador.PrincipalController">
    <top>
        <MenuBar>
            <Menu text="Gestión">
                <MenuItem text="Cursos" onAction="#onCursos"/>
                <MenuItem text="Estudiantes" onAction="#onEstudiantes"/>
                <MenuItem text="Matrícula" onAction="#onMatricula"/>
                <SeparatorMenuItem/>
                <MenuItem text="Salir" onAction="#onSalir"/>
            </Menu>
        </MenuBar>
    </top>
    <center>
        <Label text="Bienvenido al Sistema Académico UNI" style="-fx-padding: 20;"/>
    </center>
</BorderPane>